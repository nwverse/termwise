#!/bin/bash
# tw 入口：不依赖安装，直接以 -I 隔离模式运行仓库内的 tw 包。
# 从 GUI 启动的程序（ChatGPT.app 里的 Codex、桌面端 Claude Code）拿到的 PATH 很精简，
# python3 可能是系统自带的 3.9，所以这里自己找 3.11+ 的解释器（TW_PYTHON 优先）。
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
for py in "$TW_PYTHON" /opt/homebrew/bin/python3 /usr/local/bin/python3 "$(command -v python3)"; do
  [ -n "$py" ] && [ -x "$py" ] || continue
  if "$py" -I -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$py" -I -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from termwise.cli import main; sys.exit(main())' "$ROOT" "$@"
  fi
done
echo "tw: 需要 Python 3.11+（可用 TW_PYTHON 指定解释器）" >&2
exit 1
